# Frontend environment (example)
# Backend API base URL. Either VITE_API_URL or VITE_API_BASE is supported.
# Include the backend origin with or without a trailing /api.
# Production Vercel builds must set this to the deployed backend origin.
# Example: VITE_API_URL=https://jobbridge-backend.onrender.com

VITE_API_URL=http://localhost:4000/api

# Google Identity Services client ID (also configure the same audience on the backend).
VITE_GOOGLE_CLIENT_ID=
