# Backend environment configuration (example)
# Copy this file to .env and fill in real values (do NOT commit .env)

# Runtime
NODE_ENV=development
PORT=4000

# Database (MongoDB Atlas recommended)
# For Atlas, copy its standard mongodb:// direct seed-list URI from Connect > Drivers.
# Include every Atlas seed host plus the TLS, authSource, and replicaSet options Atlas provides.
# The app intentionally rejects mongodb+srv:// so SRV lookup is not required.
MONGO_URI=mongodb://127.0.0.1:27017/jobbridge_africa

# JWT & Cookies
# JWT_EXPIRE examples: 7d, 12h. COOKIE_EXPIRE is in days.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE=7d
COOKIE_EXPIRE=7

# Cloudinary (optional for local jobs browsing; required for image/resume uploads)
CLOUDINARY_CLIENT_NAME=
CLOUDINARY_CLIENT_API=
CLOUDINARY_CLIENT_SECRET=

# Email (Zoho Mail SMTP)
EMAIL_USER=info@jobbridgeafrica.org
EMAIL_PASS=your-zoho-app-password
EMAIL_FROM=info@jobbridgeafrica.org
EMAIL_HOST=smtp.zoho.com
EMAIL_PORT=465
EMAIL_SECURE=true
FRONTEND_URL=http://localhost:5173

# CORS (comma-separated origins for production)
# Example: https://www.jobbridgeafrica.org,https://jobbridge-africa.vercel.app
ALLOWED_ORIGINS=

# Enterprise ATS webhooks (optional): POST /api/employers/webhook/jobs
# Send the raw API key in the X-JobBridge-API-Key request header.
# Map SHA-256 hashes of API keys to employer MongoDB user IDs.
# Generate a key with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Hash a key with: node -e "console.log(require('node:crypto').createHash('sha256').update('YOUR_API_KEY').digest('hex'))"
# Example: {"<sha256-api-key>":"<employer-user-id>"}
JOBBRIDGE_WEBHOOK_KEYS=

# Targeted company RSS/Atom feeds or XML sitemaps (optional; HTTPS URLs only).
# Each feed needs a companyName and URL. type may be auto, rss, or sitemap.
# employerId is optional and links the listing's company reference to an employer account.
# Example: [{"companyName":"Example Company","companySlug":"example-company","url":"https://example.com/sitemap.xml","type":"sitemap"}]
CAREER_FEEDS=
# Defaults to 6 hours; minimum accepted interval is 60 seconds.
CAREER_SCRAPE_INTERVAL_MS=21600000
