# Backend environment configuration (example)
# Copy this file to .env and fill in real values (do NOT commit .env)

# Runtime
NODE_ENV=development
PORT=4000

# Database (MongoDB Atlas recommended)
# For Atlas, copy its standard mongodb:// direct seed-list URI from Connect > Drivers.
# Include every Atlas seed host plus the TLS, authSource, and replicaSet options Atlas provides.
# The app intentionally rejects mongodb+srv:// so SRV lookup is not required.
MONGO_URI=mongodb://127.0.0.1:27017/jobbridge_africa

# JWT & Cookies
# JWT_EXPIRE examples: 7d, 12h. COOKIE_EXPIRE is in days.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE=7d
COOKIE_EXPIRE=7

# Cloudinary (optional for local jobs browsing; required for image/resume uploads)
CLOUDINARY_CLIENT_NAME=
CLOUDINARY_CLIENT_API=
CLOUDINARY_CLIENT_SECRET=

# Email (Zoho Mail SMTP)
EMAIL_USER=info@jobbridgeafrica.org
EMAIL_PASS=your-zoho-app-password

# CORS (comma-separated origins for production)
# Example: https://www.jobbridgeafrica.org,https://jobbridge-africa.vercel.app
ALLOWED_ORIGINS=

# Optional SMTP overrides (defaults provided)
# EMAIL_HOST=smtp.zoho.com
# EMAIL_PORT=465
# EMAIL_SECURE=true
